---
interface Props {
  no: string;
  title: string;
  lead?: string;
}

const { no, title, lead } = Astro.props;
---

<div class="mb-6">
  <div class="flex items-baseline gap-2.5">
    <span class="font-mono text-xs font-bold tracking-widest text-emerald-400">CH.{no}</span>
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white">{title}</h2>
  </div>
  {lead && <p class="mt-1.5 text-sm sm:text-base text-gray-200 font-medium">{lead}</p>}
</div>
