---
import SectionHeader from './SectionHeader.astro';
import { CH09_CONTENT } from '../data/content';
---

<section id={CH09_CONTENT.id} class="pt-12 scroll-mt-20">
  <SectionHeader no={CH09_CONTENT.no} title={CH09_CONTENT.title} />

  <div class="grid gap-4 md:grid-cols-2">
    <!-- Pre-Trip -->
    <div class="bento-card p-5 bg-[#121820] border-[#232d3b]">
      <div class="font-mono text-xs font-bold tracking-wider text-emerald-400">
        PHASE 01
      </div>
      <h3 class="mt-1 text-base font-bold text-white">{CH09_CONTENT.preTripTitle}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {CH09_CONTENT.preTripItems.map((item) => (
          <li class="flex items-center gap-2.5 rounded bg-[#17202a] px-3 py-2.5 border border-gray-800 text-gray-100 font-medium">
            <span class="flex size-4 shrink-0 items-center justify-center rounded border border-emerald-500/50 bg-emerald-950/40 text-[10px] font-bold text-emerald-300">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- On-Trip -->
    <div class="bento-card p-5 bg-[#121820] border-[#232d3b]">
      <div class="font-mono text-xs font-bold tracking-wider text-amber-400">
        PHASE 02
      </div>
      <h3 class="mt-1 text-base font-bold text-white">{CH09_CONTENT.onTripTitle}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {CH09_CONTENT.onTripItems.map((item) => (
          <li class="flex items-center gap-2.5 rounded bg-[#17202a] px-3 py-2.5 border border-gray-800 text-gray-100 font-medium">
            <span class="flex size-4 shrink-0 items-center justify-center rounded border border-amber-500/50 bg-amber-950/40 text-[10px] font-bold text-amber-300">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
