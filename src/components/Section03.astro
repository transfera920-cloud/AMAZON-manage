---
import SectionHeader from './SectionHeader.astro';
import { CH03_CONTENT } from '../data/content';
---

<section id={CH03_CONTENT.id} class="pt-12 scroll-mt-20">
  <SectionHeader no={CH03_CONTENT.no} title={CH03_CONTENT.title} lead={CH03_CONTENT.lead} />

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {CH03_CONTENT.advantages.map((adv) => (
      <div class="bento-card p-4 bg-[#121820] border-[#232d3b] flex flex-col justify-between hover:border-gray-700 transition-colors">
        <div>
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-emerald-400">{adv.id}</span>
          </div>
          <h3 class="mt-2 text-sm sm:text-base font-bold text-white">{adv.title}</h3>
          <ul class="mt-3 space-y-1.5 text-xs text-gray-100 font-medium">
            {adv.items.map((item) => (
              <li class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        {adv.note && (
          <div class="mt-3 pt-2.5 border-t border-gray-800 text-[11px] text-amber-200 font-semibold bg-amber-950/30 p-2 rounded border border-amber-500/30 leading-relaxed">
            注意：{adv.note}
          </div>
        )}
      </div>
    ))}
  </div>
</section>
