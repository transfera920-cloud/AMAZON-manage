---
import { SITE_METADATA } from '../data/content';
---

<header class="no-print sticky top-0 z-40 border-b border-gray-800 bg-[#0b0f14]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <div class="min-w-0">
      <div class="flex items-center gap-3">
        <a 
          href={SITE_METADATA.brandUrl} 
          class="block truncate text-sm font-bold tracking-tight text-white hover:underline focus:outline-none focus:ring-2 focus:ring-emerald-400"
        >
          {SITE_METADATA.brandName}
        </a>
        <span class="hidden sm:inline text-xs text-gray-400">|</span>
        <nav aria-label="麵包屑導覽" class="hidden sm:flex items-center gap-1.5 text-xs text-gray-300">
          <a href={SITE_METADATA.brandUrl} class="hover:underline hover:text-white">首頁</a>
          <span class="text-gray-500">/</span>
          <a href={SITE_METADATA.introUrl} class="hover:underline hover:text-white">登山教育平台</a>
        </nav>
      </div>
      <div class="truncate font-mono text-[11px] font-semibold tracking-widest text-emerald-400 mt-0.5">
        {SITE_METADATA.seriesName}
      </div>
    </div>

    <button
      type="button"
      onclick="window.print()"
      class="shrink-0 rounded-md border border-emerald-500/50 bg-emerald-500/15 px-3.5 py-1.5 text-xs font-bold text-emerald-300 transition-colors hover:bg-emerald-500/25 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-400"
      aria-label="列印或另存為 PDF"
    >
      列印 / PDF
    </button>
  </div>
</header>
