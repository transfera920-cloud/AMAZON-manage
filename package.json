{
  "name": "amazon-explore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "astro dev --port 3000 --host 0.0.0.0",
    "build": "astro build && node scripts/generate-sitemap.mjs && node scripts/post-build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^5.4.2",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
